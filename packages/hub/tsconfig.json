{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "noEmit": false,
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "emitDeclarationOnly": true,
    "removeComments": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@tessel/core": ["../core/src/index.ts"],
      "@tessel/studio": ["../../studio/src/index.ts"],
      "@tessel/game": ["../game/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.*", "**/*.spec.*", "**/*.css", "**/*.module.css"],
  "references": [{ "path": "../core" }]
}
