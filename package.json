{
  "name": "@tessel/root",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "// APPS ": "----------------------------------------------------",
    "dev:web": "pnpm --filter @tessel/platform-web dev",
    "build:web": "pnpm --filter @tessel/platform-web build",
    "dev:desktop": "pnpm --filter @tessel/platform-desktop dev",
    "build:desktop": "pnpm --filter @tessel/platform-desktop build",
    "dev:api": "pnpm --filter @tessel/api dev",
    "build:api": "pnpm --filter @tessel/api build",
    "start:api": "pnpm --filter @tessel/api start",
    "lint": "turbo lint",
    "// Studio / Penpot": "---------------------------------------------",
    "penpot:up": "pnpm --filter @tessel/studio penpot:up",
    "penpot:down": "pnpm --filter @tessel/studio penpot:down",
    "penpot:reset": "pnpm --filter @tessel/studio penpot:reset",
    "penpot:update": "pnpm --filter @tessel/studio penpot:update",
    "penpot:aide:up": "pnpm --filter @tessel/studio aide:up",
    "penpot:aide:down": "pnpm --filter @tessel/studio aide:down",
    "// CI/CD & Quality": "-------------------------------------------------",
    "project:clean": "npx npkill"
  },
  "devDependencies": {
    "@eslint/js": "catalog:tooling-stack",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:tooling-stack",
    "eslint": "catalog:tooling-stack",
    "eslint-import-resolver-typescript": "catalog:tooling-stack",
    "eslint-plugin-import": "catalog:tooling-stack",
    "eslint-plugin-react": "catalog:web-stack",
    "eslint-plugin-react-hooks": "catalog:web-stack",
    "eslint-plugin-react-refresh": "catalog:web-stack",
    "kill-port": "catalog:",
    "prettier": "catalog:tooling-stack",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:tooling-stack",
    "turbo": "catalog:"
  }
}
